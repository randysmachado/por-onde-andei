---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  travel: CollectionEntry<'viagem'>;
}

const { travel } = Astro.props;
const { title, description, date, cover, location, tags } = travel.data;
const slug = travel.id.replace('/index', '');
const url = `/viagens/${slug}`;

const formattedDate = date.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-700 bg-slate-800/50 hover:border-amber-500/50 transition-all duration-300 hover:shadow-2xl hover:shadow-amber-500/10 hover:-translate-y-1">
  <!-- Cover Image -->
  <a href={url} class="block overflow-hidden aspect-[16/9] bg-slate-700">
    {cover ? (
      <Image
        src={cover}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        widths={[400, 800]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-700 to-slate-900">
        <span class="text-5xl opacity-30">🌍</span>
      </div>
    )}
  </a>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5">
    <!-- Location & Date -->
    <div class="flex items-center justify-between mb-3 text-xs text-slate-400">
      <span class="flex items-center gap-1.5">
        {location.flag && <span>{location.flag}</span>}
        <span>{location.name}, {location.country}</span>
      </span>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </div>

    <!-- Title -->
    <a href={url} class="mb-2 group/title">
      <h2 class="text-xl font-bold text-white leading-snug group-hover/title:text-amber-400 transition-colors line-clamp-2">
        {title}
      </h2>
    </a>

    <!-- Description -->
    <p class="text-sm text-slate-400 leading-relaxed line-clamp-3 flex-1 mb-4">
      {description}
    </p>

    <!-- Tags -->
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4">
        {tags.slice(0, 3).map((tag) => (
          <span class="text-xs px-2.5 py-1 rounded-full bg-slate-700 text-slate-300">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- CTA -->
    <a
      href={url}
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-amber-400 hover:text-amber-300 transition-colors"
    >
      Ler relato
      <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</article>
