---
// "website" | "article" (local/[slug]) | "collection" (locais) | "about" (sobre)
export type SchemaType = "website" | "article" | "collection" | "about";

interface Props {
  type?: SchemaType;
  title: string;
  description: string;
  url: string;
  image?: string;
  publishDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  // Específico para artigos de local
  locationName?: string;
  lat?: number;
  lng?: number;
  country?: string;
  category?: string;
}

const {
  type = "website",
  title,
  description,
  url,
  image,
  publishDate,
  updatedDate,
  tags = [],
  locationName,
  lat,
  lng,
  country,
  category,
} = Astro.props;

const siteUrl = "https://porondeandei.randys.dev";
const siteName = "Por Onde Andei";
const authorName = "Randys Machado";

// Remove o sufixo do título para usar como headline puro
const SUFFIX_LONG = ` · ${siteName} | De ${authorName}.`;
const SUFFIX_SHORT = ` · ${siteName}`;
const headline = title.endsWith(SUFFIX_LONG)
  ? title.slice(0, -SUFFIX_LONG.length)
  : title.endsWith(SUFFIX_SHORT)
    ? title.slice(0, -SUFFIX_SHORT.length)
    : title;

// ── Entidade base: Person (autor) ─────────────────────────────
const person = {
  "@type": "Person",
  "@id": `${siteUrl}/#author`,
  name: authorName,
  url: siteUrl,
  sameAs: ["https://twitter.com/randysmachado"],
};

// ── WebSite (todas as páginas) — sem SearchAction (filtro é client-side)
const website = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  url: siteUrl,
  name: siteName,
  description:
    "Diário de viagens e passeios de Randys Machado — locais, fotos e histórias pelo Brasil e pelo mundo.",
  publisher: { "@id": `${siteUrl}/#author` },
  inLanguage: "pt-BR",
};

// ── WebPage base ──────────────────────────────────────────────
const webpage = {
  "@type": "WebPage",
  "@id": `${url}#webpage`,
  url,
  name: title,
  description,
  isPartOf: { "@id": `${siteUrl}/#website` },
  inLanguage: "pt-BR",
  ...(image ? { primaryImageOfPage: { "@type": "ImageObject", url: image } } : {}),
};

// ── Schemas condicionais ──────────────────────────────────────
const conditionalSchemas: object[] = [];

if (type === "article") {
  // BreadcrumbList — hierarquia da página no site
  const breadcrumb = {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
      { "@type": "ListItem", position: 2, name: "Locais", item: `${siteUrl}/locais/` },
      { "@type": "ListItem", position: 3, name: headline },
    ],
  };

  // TouristAttraction — o local visitado
  const place: Record<string, unknown> = {
    "@type": "TouristAttraction",
    "@id": `${url}#place`,
    name: locationName ?? headline,
    ...(country ? { addressCountry: country } : {}),
  };

  if (lat !== undefined && lng !== undefined) {
    place.geo = {
      "@type": "GeoCoordinates",
      latitude: lat,
      longitude: lng,
    };
    place.hasMap = `https://www.google.com/maps?q=${lat},${lng}`;
  }

  if (locationName) {
    place.address = {
      "@type": "PostalAddress",
      addressLocality: locationName,
      ...(country ? { addressCountry: country } : {}),
    };
  }

  // BlogPosting — o relato da visita
  const blogPost: Record<string, unknown> = {
    "@type": "BlogPosting",
    "@id": `${url}#article`,
    mainEntityOfPage: { "@id": `${url}#webpage` },
    headline,
    description,
    url,
    ...(image
      ? {
          image: {
            "@type": "ImageObject",
            url: image,
            width: 1200,
            height: 630,
          },
        }
      : {}),
    author: { "@id": `${siteUrl}/#author` },
    publisher: { "@id": `${siteUrl}/#author` },
    inLanguage: "pt-BR",
    ...(publishDate
      ? {
          datePublished: publishDate.toISOString(),
          dateModified: (updatedDate ?? publishDate).toISOString(),
        }
      : {}),
    ...(tags.length > 0 ? { keywords: tags.join(", ") } : {}),
    ...(category ? { articleSection: category } : {}),
    about: { "@id": `${url}#place` },
    isPartOf: { "@id": `${siteUrl}/#website` },
  };

  conditionalSchemas.push(breadcrumb, place, blogPost);
}

if (type === "collection") {
  conditionalSchemas.push({
    "@type": "CollectionPage",
    "@id": `${url}#collection`,
    mainEntityOfPage: { "@id": `${url}#webpage` },
    name: title,
    description,
    url,
    author: { "@id": `${siteUrl}/#author` },
    isPartOf: { "@id": `${siteUrl}/#website` },
    inLanguage: "pt-BR",
  });
}

if (type === "about") {
  conditionalSchemas.push({
    "@type": "AboutPage",
    "@id": `${url}#about`,
    mainEntityOfPage: { "@id": `${url}#webpage` },
    name: title,
    description,
    url,
    author: { "@id": `${siteUrl}/#author` },
    isPartOf: { "@id": `${siteUrl}/#website` },
    inLanguage: "pt-BR",
  });
}

// ── Grafo final ───────────────────────────────────────────────
const graph = {
  "@context": "https://schema.org",
  "@graph": [person, website, webpage, ...conditionalSchemas],
};

const jsonLd = JSON.stringify(graph);
---

<script type="application/ld+json" set:html={jsonLd} />
