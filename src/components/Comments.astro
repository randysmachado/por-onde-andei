---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section class="comments" id="comments" data-slug={slug} data-turnstile-key={siteKey}>
  <div class="comments-inner">
    <div class="comments-heading">
      <span class="comments-eyebrow">Compartilhe conosco</span>
      <h2 class="comments-title">Deixe seu comentário</h2>
      <p class="comments-subtitle">
        Já esteve por aqui ou tem alguma dúvida sobre o lugar? Conta pra gente.
      </p>
    </div>

    <div class="comments-toolbar" id="comments-toolbar" hidden>
      <span class="comments-count-label" id="comments-count-label"></span>
      <div class="comments-sort" role="group" aria-label="Ordenar comentários">
        <button type="button" class="sort-btn" id="sort-newest" data-order="newest">
          Mais recentes
        </button>
        <button type="button" class="sort-btn" id="sort-oldest" data-order="oldest">
          Mais antigos
        </button>
      </div>
    </div>

    <ul class="comments-list" id="comments-list"></ul>

    <form class="comments-form" id="comments-form" novalidate>
      <div class="form-row">
        <label for="c-name">Nome</label>
        <input id="c-name" name="name" type="text" maxlength="80" />
        <p class="field-error" id="err-name" hidden></p>
      </div>
      <div class="form-row">
        <label for="c-email">E-mail (não exibido publicamente)</label>
        <input id="c-email" name="email" type="email" />
        <p class="field-error" id="err-email" hidden></p>
      </div>
      <div class="form-row">
        <label for="c-comment">Comentário</label>
        <textarea
          id="c-comment"
          name="comment"
          maxlength="2000"
          rows="4"
          placeholder="Escreva aqui o que achou, uma dica ou uma pergunta…"
        ></textarea>
        <p class="field-error" id="err-comment" hidden></p>
      </div>
      <div class="cf-turnstile" data-sitekey={siteKey}></div>
      <button type="submit">Enviar comentário</button>
      <p class="comments-error" id="comments-error" hidden></p>
    </form>
  </div>
</section>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
></script>

<script>
  import { z } from "zod";
  import { commentSchema } from "../lib/commentSchema";

  type ApiComment = {
    id: string;
    name: string;
    comment: string;
    date: string;
    parentId: string;
    isAuthor: boolean;
  };

  type CommentThread = { root: ApiComment; replies: ApiComment[] };

  type SortOrder = "newest" | "oldest";

  function groupComments(comments: ApiComment[]): CommentThread[] {
    const roots = comments.filter((c) => !c.parentId);
    return roots.map((root) => ({
      root,
      replies: comments
        .filter((c) => c.parentId === root.id)
        .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()),
    }));
  }

  const section = document.getElementById("comments") as HTMLElement;
  const slug = section.dataset.slug!;
  const list = document.getElementById("comments-list") as HTMLUListElement;
  const form = document.getElementById("comments-form") as HTMLFormElement;
  const errorEl = document.getElementById("comments-error") as HTMLParagraphElement;
  const toolbar = document.getElementById("comments-toolbar") as HTMLDivElement;
  const countLabel = document.getElementById("comments-count-label") as HTMLSpanElement;
  const sortButtons = {
    newest: document.getElementById("sort-newest") as HTMLButtonElement,
    oldest: document.getElementById("sort-oldest") as HTMLButtonElement,
  };

  let loadedComments: ApiComment[] = [];
  let currentSort: SortOrder = "newest";

  const fieldErrorEls = {
    name: document.getElementById("err-name") as HTMLParagraphElement,
    email: document.getElementById("err-email") as HTMLParagraphElement,
    comment: document.getElementById("err-comment") as HTMLParagraphElement,
  };

  function clearFieldErrors() {
    for (const el of Object.values(fieldErrorEls)) {
      el.hidden = true;
      el.textContent = "";
    }
  }

  function showFieldErrors(fieldErrors: Partial<Record<string, string[]>>) {
    for (const [field, messages] of Object.entries(fieldErrors)) {
      const el = fieldErrorEls[field as keyof typeof fieldErrorEls];
      if (el && messages?.[0]) {
        el.textContent = messages[0];
        el.hidden = false;
      }
    }
  }

  function sortedThreads(threads: CommentThread[], order: SortOrder): CommentThread[] {
    const sorted = [...threads].sort(
      (a, b) => new Date(a.root.date).getTime() - new Date(b.root.date).getTime(),
    );
    return order === "newest" ? sorted.reverse() : sorted;
  }

  function updateSortButtons() {
    for (const [order, btn] of Object.entries(sortButtons)) {
      btn.classList.toggle("active", order === currentSort);
    }
  }

  function buildCommentEl(c: ApiComment, opts: { isReply: boolean }): HTMLLIElement {
    const li = document.createElement("li");
    li.className =
      "comment-item" +
      (opts.isReply ? " comment-reply" : "") +
      (c.isAuthor ? " comment-author" : "");
    li.dataset.commentId = c.id;

    const header = document.createElement("div");
    header.className = "comment-header";

    const avatar = document.createElement("div");
    avatar.className = "comment-avatar";
    avatar.textContent = c.name.trim().charAt(0).toUpperCase() || "?";

    const meta = document.createElement("div");
    meta.className = "comment-meta";

    const name = document.createElement("span");
    name.className = "comment-name";
    name.textContent = c.name;
    if (c.isAuthor) {
      const badge = document.createElement("span");
      badge.className = "comment-author-badge";
      badge.textContent = "autor";
      name.appendChild(badge);
    }

    const date = document.createElement("span");
    date.className = "comment-date";
    date.textContent = new Date(c.date).toLocaleDateString("pt-BR");

    meta.appendChild(name);
    meta.appendChild(date);
    header.appendChild(avatar);
    header.appendChild(meta);

    const body = document.createElement("p");
    body.className = "comment-body";
    body.textContent = c.comment;

    li.appendChild(header);
    li.appendChild(body);

    if (!opts.isReply) {
      const replyBtn = document.createElement("button");
      replyBtn.type = "button";
      replyBtn.className = "reply-btn";
      replyBtn.textContent = "Responder";
      replyBtn.dataset.parentId = c.id;
      li.appendChild(replyBtn);
    }

    return li;
  }

  function renderComments(comments: ApiComment[]) {
    list.textContent = "";

    if (comments.length === 0) {
      toolbar.hidden = true;
      const li = document.createElement("li");
      li.className = "comments-empty";
      li.textContent = "Seja o primeiro a comentar.";
      list.appendChild(li);
      return;
    }

    toolbar.hidden = false;
    countLabel.textContent =
      comments.length === 1 ? "1 comentário" : `${comments.length} comentários`;
    updateSortButtons();

    const threads = groupComments(comments);
    for (const thread of sortedThreads(threads, currentSort)) {
      const rootLi = buildCommentEl(thread.root, { isReply: false });
      list.appendChild(rootLi);

      if (thread.replies.length > 0) {
        const repliesWrap = document.createElement("li");
        repliesWrap.className = "comment-replies";
        for (const reply of thread.replies) {
          repliesWrap.appendChild(buildCommentEl(reply, { isReply: true }));
        }
        list.appendChild(repliesWrap);
      }

      attachReplyForm(rootLi, thread.root.id);
    }
  }

  function renderSkeleton() {
    list.textContent = "";
    for (let i = 0; i < 3; i++) {
      const li = document.createElement("li");
      li.className = "comment-item comment-skeleton";
      li.innerHTML = `
        <div class="comment-header">
          <div class="comment-avatar skeleton-block"></div>
          <div class="comment-meta">
            <span class="skeleton-block skeleton-line" style="width:120px;height:14px;"></span>
            <span class="skeleton-block skeleton-line" style="width:70px;height:11px;"></span>
          </div>
        </div>
        <div class="skeleton-block skeleton-line" style="width:100%;height:12px;margin-top:10px;"></div>
        <div class="skeleton-block skeleton-line" style="width:80%;height:12px;margin-top:8px;"></div>
      `;
      list.appendChild(li);
    }
  }

  function attachReplyForm(rootLi: HTMLLIElement, parentId: string) {
    const replyBtn = rootLi.querySelector<HTMLButtonElement>(".reply-btn");
    if (!replyBtn) return;

    replyBtn.addEventListener("click", () => {
      const existingForm = rootLi.querySelector(".reply-form");
      if (existingForm) {
        existingForm.remove();
        return;
      }

      const wrap = document.createElement("div");
      wrap.className = "reply-form";
      wrap.innerHTML = `
        <div class="form-row">
          <label>Nome</label>
          <input type="text" class="reply-name" maxlength="80" />
          <p class="field-error reply-err-name" hidden></p>
        </div>
        <div class="form-row">
          <label>E-mail (não exibido publicamente)</label>
          <input type="email" class="reply-email" />
          <p class="field-error reply-err-email" hidden></p>
        </div>
        <div class="form-row">
          <label>Resposta</label>
          <textarea class="reply-comment" maxlength="2000" rows="3"></textarea>
          <p class="field-error reply-err-comment" hidden></p>
        </div>
        <div class="cf-turnstile" data-sitekey="${section.dataset.turnstileKey}"></div>
        <div class="reply-form-actions">
          <button type="button" class="reply-submit">Enviar resposta</button>
          <button type="button" class="reply-cancel">Cancelar</button>
        </div>
        <p class="reply-error" hidden></p>
      `;
      rootLi.appendChild(wrap);
      // @ts-expect-error turnstile é injetado pelo script externo
      window.turnstile?.render(wrap.querySelector(".cf-turnstile"));

      wrap.querySelector(".reply-cancel")?.addEventListener("click", () => wrap.remove());

      wrap.querySelector(".reply-submit")?.addEventListener("click", async () => {
        const nameInput = wrap.querySelector(".reply-name") as HTMLInputElement;
        const emailInput = wrap.querySelector(".reply-email") as HTMLInputElement;
        const commentInput = wrap.querySelector(".reply-comment") as HTMLTextAreaElement;
        const errName = wrap.querySelector(".reply-err-name") as HTMLParagraphElement;
        const errEmail = wrap.querySelector(".reply-err-email") as HTMLParagraphElement;
        const errComment = wrap.querySelector(".reply-err-comment") as HTMLParagraphElement;
        const errGeneral = wrap.querySelector(".reply-error") as HTMLParagraphElement;
        const submitBtn = wrap.querySelector(".reply-submit") as HTMLButtonElement;

        for (const el of [errName, errEmail, errComment, errGeneral]) el.hidden = true;

        const parsed = commentSchema.safeParse({
          name: nameInput.value,
          email: emailInput.value,
          comment: commentInput.value,
        });
        if (!parsed.success) {
          const fieldErrors = z.flattenError(parsed.error).fieldErrors;
          if (fieldErrors.name?.[0]) {
            errName.textContent = fieldErrors.name[0];
            errName.hidden = false;
          }
          if (fieldErrors.email?.[0]) {
            errEmail.textContent = fieldErrors.email[0];
            errEmail.hidden = false;
          }
          if (fieldErrors.comment?.[0]) {
            errComment.textContent = fieldErrors.comment[0];
            errComment.hidden = false;
          }
          return;
        }

        const turnstileTokenInput = wrap.querySelector<HTMLInputElement>(
          'input[name="cf-turnstile-response"]',
        );
        const turnstileToken = turnstileTokenInput?.value ?? null;

        const defaultText = submitBtn.textContent ?? "Enviar resposta";
        submitBtn.disabled = true;
        submitBtn.textContent = "Publicando sua resposta, aguarde…";

        try {
          const res = await fetch("/api/comments", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ slug, ...parsed.data, turnstileToken, parentId }),
          });
          const data = await res.json();
          if (!res.ok) {
            errGeneral.textContent = data.error ?? "Não foi possível enviar sua resposta.";
            errGeneral.hidden = false;
            return;
          }
          wrap.remove();
          await loadComments();
        } catch {
          errGeneral.textContent = "Não foi possível enviar sua resposta, tente novamente.";
          errGeneral.hidden = false;
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = defaultText;
        }
      });
    });
  }

  async function loadComments() {
    renderSkeleton();
    try {
      const res = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`);
      const data = await res.json();
      loadedComments = data.comments ?? [];
      renderComments(loadedComments);
    } catch {
      toolbar.hidden = true;
      list.textContent = "";
      const li = document.createElement("li");
      li.className = "comments-empty";
      li.textContent = "Não foi possível carregar os comentários.";
      list.appendChild(li);
    }
  }

  for (const [order, btn] of Object.entries(sortButtons)) {
    btn.addEventListener("click", () => {
      currentSort = order as SortOrder;
      renderComments(loadedComments);
    });
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    clearFieldErrors();

    const formData = new FormData(form);
    const turnstileToken = formData.get("cf-turnstile-response") as string | null;

    const rawInput = {
      name: formData.get("name"),
      email: formData.get("email"),
      comment: formData.get("comment"),
    };

    const parsed = commentSchema.safeParse(rawInput);
    if (!parsed.success) {
      showFieldErrors(z.flattenError(parsed.error).fieldErrors);
      return;
    }

    const payload = { slug, ...parsed.data, turnstileToken };

    const submitBtn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    const submitBtnDefaultText = submitBtn.textContent ?? "Enviar comentário";
    submitBtn.disabled = true;
    submitBtn.textContent = "Publicando seu comentário, aguarde…";

    try {
      const res = await fetch("/api/comments", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (!res.ok) {
        if (data.fieldErrors) {
          showFieldErrors(data.fieldErrors);
        } else {
          errorEl.textContent = data.error ?? "Não foi possível enviar seu comentário.";
          errorEl.hidden = false;
        }
        return;
      }

      form.reset();
      // @ts-expect-error turnstile é injetado pelo script externo
      window.turnstile?.reset();
      await loadComments();
    } catch {
      errorEl.textContent = "Não foi possível enviar seu comentário, tente novamente.";
      errorEl.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = submitBtnDefaultText;
    }
  });

  loadComments();
</script>

<style is:global>
  /* Estas classes são aplicadas a elementos criados via document.createElement
     no <script> do componente — o escopo automático do Astro só cobre
     elementos escritos no template, por isso o bloco inteiro é global.
     Nomes prefixados com "comment(s)-" evitam colisão com o resto do site. */
  .comments {
    max-width: 900px;
    margin: 56px auto 0;
    padding: 0 32px 64px;
  }
  .comments-inner {
    background: linear-gradient(
      165deg,
      var(--panel) 0%,
      var(--panel-2) 100%
    );
    border: 1px solid var(--line-2);
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }
  .comments-heading {
    max-width: 560px;
    margin: 0 0 32px;
  }
  .comments-eyebrow {
    display: inline-block;
    font-family: var(--ui);
    font-size: 11px;
    text-transform: var(--eyebrow-tt);
    letter-spacing: var(--eyebrow-ls);
    font-weight: var(--eyebrow-fw);
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid rgba(230, 134, 58, 0.3);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 14px;
  }
  .comments-title {
    font-family: var(--display);
    font-size: 40px;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin: 0 0 10px;
    font-weight: 400;
    line-height: 1.05;
  }
  .comments-subtitle {
    font-family: var(--body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }
  .comments-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 16px;
    flex-wrap: wrap;
  }
  .comments-count-label {
    font-family: var(--ui);
    font-size: 12px;
    text-transform: var(--eyebrow-tt);
    letter-spacing: var(--eyebrow-ls);
    font-weight: var(--eyebrow-fw);
    color: var(--ink-3);
  }
  .comments-sort {
    display: inline-flex;
    gap: 4px;
    background: var(--bg);
    border: 1px solid var(--line-2);
    border-radius: 999px;
    padding: 3px;
  }
  .sort-btn {
    font-family: var(--ui);
    font-size: 11px;
    text-transform: var(--eyebrow-tt);
    letter-spacing: var(--eyebrow-ls);
    font-weight: var(--eyebrow-fw);
    color: var(--ink-3);
    background: transparent;
    border: none;
    border-radius: 999px;
    padding: 6px 14px;
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }
  .sort-btn:hover {
    color: var(--ink);
  }
  .sort-btn.active {
    background: var(--accent);
    color: #1a1411;
  }
  .comments-list {
    list-style: none;
    margin: 0 0 40px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .comments-loading,
  .comments-empty {
    font-family: var(--body);
    font-size: 16px;
    color: var(--ink-3);
  }
  .comment-item {
    background: var(--bg);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    padding: 18px 20px;
  }
  .skeleton-block {
    display: inline-block;
    border-radius: 6px;
    background: linear-gradient(
      90deg,
      var(--panel-2) 25%,
      var(--line-2) 50%,
      var(--panel-2) 75%
    );
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.4s ease-in-out infinite;
  }
  .comment-skeleton .comment-avatar.skeleton-block {
    background: var(--panel-2);
  }
  .skeleton-line {
    border-radius: 4px;
  }
  @keyframes skeleton-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
  .comment-header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 8px;
  }
  .comment-avatar {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    display: grid;
    place-items: center;
    font-family: var(--ui);
    font-weight: 700;
    font-size: 16px;
  }
  .comment-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .comment-name {
    font-family: var(--ui);
    font-weight: 700;
    font-size: 17px;
    color: var(--ink);
  }
  .comment-date {
    font-family: var(--ui);
    font-size: 13px;
    color: var(--ink-3);
  }
  .comment-body {
    font-family: var(--body);
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 0;
    white-space: pre-wrap;
  }
  .comments-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .form-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-row label {
    font-family: var(--ui);
    font-size: 12px;
    text-transform: var(--eyebrow-tt);
    letter-spacing: var(--eyebrow-ls);
    font-weight: var(--eyebrow-fw);
    color: var(--ink-2);
  }
  .form-row input,
  .form-row textarea {
    font-family: var(--body);
    font-size: 16px;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line-2);
    border-radius: 8px;
    padding: 12px 14px;
    resize: vertical;
  }
  .form-row input:focus,
  .form-row textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .field-error {
    font-family: var(--ui);
    font-size: 13px;
    color: #e6863a;
    margin: 0;
  }
  .comments-form button[type="submit"] {
    align-self: flex-start;
    background: var(--accent);
    color: #1a1411;
    border: none;
    padding: 10px 20px;
    border-radius: 999px;
    font-family: var(--ui);
    font-size: 12px;
    text-transform: var(--eyebrow-tt);
    letter-spacing: var(--eyebrow-ls);
    font-weight: var(--eyebrow-fw);
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .comments-form button[type="submit"]:hover {
    opacity: 0.9;
  }
  .comments-form button[type="submit"]:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .comments-error {
    color: #e6863a;
    font-family: var(--ui);
    font-size: 14px;
    margin: 0;
  }
  .comment-replies {
    list-style: none;
    margin: 0 0 0 32px;
    padding: 10px 0 0 16px;
    border-left: 2px solid var(--line-2);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .comment-reply {
    padding: 14px 16px;
  }
  .comment-reply .comment-avatar {
    width: 32px;
    height: 32px;
    font-size: 13px;
  }
  .comment-reply .comment-name {
    font-size: 15px;
  }
  .comment-reply .comment-body {
    font-size: 15px;
  }
  .reply-btn {
    margin-top: 10px;
    background: transparent;
    border: none;
    color: var(--ink-3);
    font-family: var(--ui);
    font-size: 12px;
    text-transform: var(--eyebrow-tt);
    letter-spacing: var(--eyebrow-ls);
    font-weight: var(--eyebrow-fw);
    cursor: pointer;
    padding: 0;
  }
  .reply-btn:hover {
    color: var(--accent);
  }
  .reply-form {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .reply-form-actions {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .reply-submit {
    background: var(--accent);
    color: #1a1411;
    border: none;
    padding: 8px 16px;
    border-radius: 999px;
    font-family: var(--ui);
    font-size: 12px;
    text-transform: var(--eyebrow-tt);
    letter-spacing: var(--eyebrow-ls);
    font-weight: var(--eyebrow-fw);
    cursor: pointer;
  }
  .reply-submit:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .reply-cancel {
    background: transparent;
    border: none;
    color: var(--ink-3);
    font-family: var(--ui);
