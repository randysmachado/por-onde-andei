---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section class="comments" id="comments" data-slug={slug}>
  <h2 class="comments-title">Comentários</h2>

  <ul class="comments-list" id="comments-list">
    <li class="comments-loading">Carregando comentários…</li>
  </ul>

  <form class="comments-form" id="comments-form">
    <div class="form-row">
      <label for="c-name">Nome</label>
      <input id="c-name" name="name" type="text" required maxlength="80" />
    </div>
    <div class="form-row">
      <label for="c-email">E-mail (não exibido publicamente)</label>
      <input id="c-email" name="email" type="email" required />
    </div>
    <div class="form-row">
      <label for="c-comment">Comentário</label>
      <textarea id="c-comment" name="comment" required maxlength="2000" rows="4"
      ></textarea>
    </div>
    <div class="cf-turnstile" data-sitekey={siteKey}></div>
    <button type="submit">Enviar comentário</button>
    <p class="comments-error" id="comments-error" hidden></p>
  </form>
</section>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer
></script>

<script>
  type ApiComment = { name: string; comment: string; date: string };

  const section = document.getElementById("comments") as HTMLElement;
  const slug = section.dataset.slug!;
  const list = document.getElementById("comments-list") as HTMLUListElement;
  const form = document.getElementById("comments-form") as HTMLFormElement;
  const errorEl = document.getElementById("comments-error") as HTMLParagraphElement;

  function renderComments(comments: ApiComment[]) {
    list.textContent = "";
    if (comments.length === 0) {
      const li = document.createElement("li");
      li.className = "comments-empty";
      li.textContent = "Seja o primeiro a comentar.";
      list.appendChild(li);
      return;
    }
    for (const c of comments) {
      const li = document.createElement("li");
      li.className = "comment-item";

      const header = document.createElement("div");
      header.className = "comment-header";

      const name = document.createElement("span");
      name.className = "comment-name";
      name.textContent = c.name;

      const date = document.createElement("span");
      date.className = "comment-date";
      date.textContent = new Date(c.date).toLocaleDateString("pt-BR");

      header.appendChild(name);
      header.appendChild(date);

      const body = document.createElement("p");
      body.className = "comment-body";
      body.textContent = c.comment;

      li.appendChild(header);
      li.appendChild(body);
      list.appendChild(li);
    }
  }

  async function loadComments() {
    try {
      const res = await fetch(`/api/comments?slug=${encodeURIComponent(slug)}`);
      const data = await res.json();
      renderComments(data.comments ?? []);
    } catch {
      list.textContent = "";
      const li = document.createElement("li");
      li.className = "comments-empty";
      li.textContent = "Não foi possível carregar os comentários.";
      list.appendChild(li);
    }
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.hidden = true;

    const formData = new FormData(form);
    const turnstileToken = formData.get("cf-turnstile-response") as string | null;

    const payload = {
      slug,
      name: formData.get("name"),
      email: formData.get("email"),
      comment: formData.get("comment"),
      turnstileToken,
    };

    const submitBtn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    submitBtn.disabled = true;

    try {
      const res = await fetch("/api/comments", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (!res.ok) {
        errorEl.textContent = data.error ?? "Não foi possível enviar seu comentário.";
        errorEl.hidden = false;
        return;
      }

      form.reset();
      // @ts-expect-error turnstile é injetado pelo script externo
      window.turnstile?.reset();
      await loadComments();
    } catch {
      errorEl.textContent = "Não foi possível enviar seu comentário, tente novamente.";
      errorEl.hidden = false;
    } finally {
      submitBtn.disabled = false;
    }
  });

  loadComments();
</script>

<style>
  .comments {
    max-width: 720px;
    margin: 48px auto 0;
    padding: 32px 32px 0;
    border-top: 1px solid var(--line);
  }
  .comments-title {
    font-family: var(--display);
    font-size: 32px;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin: 0 0 24px;
    font-weight: 400;
  }
  .comments-list {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .comments-loading,
  .comments-empty {
    font-family: var(--body);
    font-size: 14px;
    color: var(--ink-3);
  }
  .comment-item {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
  }
  .comment-header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }
  .comment-name {
    font-family: var(--ui);
    font-weight: 700;
    font-size: 13px;
    color: var(--ink);
  }
  .comment-date {
    font-family: var(--ui);
    font-size: 11px;
    color: var(--ink-3);
  }
  .comment-body {
    font-family: var(--body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
    white-space: pre-wrap;
  }
  .comments-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-bottom: 48px;
  }
  .form-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-row label {
    font-family: var(--ui);
    font-size: 11px;
    text-transform: var(--eyebrow-tt);
    letter-spacing: var(--eyebrow-ls);
    font-weight: var(--eyebrow-fw);
    color: var(--ink-2);
  }
  .form-row input,
  .form-row textarea {
    font-family: var(--body);
    font-size: 14px;
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--line-2);
    border-radius: 8px;
    padding: 10px 12px;
    resize: vertical;
  }
  .form-row input:focus,
  .form-row textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .comments-form button[type="submit"] {
    align-self: flex-start;
    background: var(--accent);
    color: #1a1411;
    border: none;
    padding: 10px 20px;
    border-radius: 999px;
    font-family: var(--ui);
    font-size: 12px;
    text-transform: var(--eyebrow-tt);
    letter-spacing: var(--eyebrow-ls);
    font-weight: var(--eyebrow-fw);
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .comments-form button[type="submit"]:hover {
    opacity: 0.9;
  }
  .comments-form button[type="submit"]:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .comments-error {
    color: #e6863a;
    font-family: var(--ui);
    font-size: 13px;
    margin: 0;
  }
</style>
