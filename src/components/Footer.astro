---
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-800 bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <svg
          class="w-5 h-5 text-amber-400"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21 4 19 4c-1 0-2 .5-3.5 2L11 9.2 3 7.4c-2-.3-2.5.7-1.2 2L5 12l2 4c.3.6 1 .9 1.6.7L12 15l2.8 1.9c1.3.8 2.9.1 3.4-1.3L17.8 19.2z"/>
        </svg>
        <span class="font-bold text-white">Minhas Viagens</span>
      </div>
      <p class="text-sm text-slate-500">
        © {year} Minhas Viagens — Explorando o mundo, um destino de cada vez.
      </p>
    </div>
  </div>
</footer>
