---
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";

interface Props {
  travels: CollectionEntry<"local">[];
}

const { travels } = Astro.props;

// Pré-processa as imagens de capa em dois tamanhos:
// • pinThumb: 72×72 (pin com foto no mapa, exibido em 36×36 @2x)
// • popupCover: 560×280 (popup do mapa, exibido em 280×140 @2x)
const mapData = await Promise.all(
  travels
    .filter((t) => !t.data.draft)
    .map(async (t) => {
      let pinThumb = "";
      let popupCover = "";

      if (t.data.cover) {
        const [pin, popup] = await Promise.all([
          getImage({ src: t.data.cover, width: 72, height: 72, format: "webp" }),
          getImage({ src: t.data.cover, width: 560, height: 280, format: "webp" }),
        ]);
        pinThumb = pin.src;
        popupCover = popup.src;
      }

      return {
        id: t.id.replace("/index", ""),
        title: t.data.title,
        lat: t.data.location.lat,
        lng: t.data.location.lng,
        locationName: t.data.location.name,
        country: t.data.location.country ?? "",
        date: t.data.date.toLocaleDateString("pt-BR", {
          month: "long",
          year: "numeric",
        }),
        excerpt: t.data.excerpt ?? t.data.description.slice(0, 140),
        cover: pinThumb,
        popupCover,
        url: `/local/${t.id.replace("/index", "")}`,
      };
    }),
);

const travelsJson = JSON.stringify(mapData);
---

<div class="map-wrap" id="map-wrap">
  <div id="travel-map" data-screen-label="Mapa"></div>
  <div class="map-hint" id="map-hint">Clique num pin para abrir o local</div>
</div>

<script type="application/json" id="travels-data" set:html={travelsJson} />

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  type TravelData = {
    id: string;
    title: string;
    lat: number;
    lng: number;
    locationName: string;
    country: string;
    date: string;
    excerpt: string;
    cover: string;
    popupCover: string;
    url: string;
  };

  const dataEl = document.getElementById("travels-data");
  if (!dataEl?.textContent) throw new Error("travels-data not found");
  const travels: TravelData[] = JSON.parse(dataEl.textContent);

  // ── Map init ───────────────────────────────────────────
  const map = L.map("travel-map", {
    center: [-14, -53], // Brasil
    zoom: 5,
    minZoom: 3,
    maxZoom: 18,
    worldCopyJump: true,
    zoomControl: true,
  });
  map.zoomControl.setPosition("bottomright");

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    maxZoom: 19,
  }).addTo(map);

  // ── Pin icon builder ──────────────────────────────────────
  function buildPin(t: TravelData, index: number): L.DivIcon {
    const num = String(index + 1).padStart(2, "0");
    if (t.cover) {
      return L.divIcon({
        className: "pin-icon",
        iconSize: [46, 56],
        iconAnchor: [23, 56],
        popupAnchor: [0, -58],
        html: `<div class="pin">
          <div class="pin-frame" data-num="${num}">
            <img class="pin-photo" src="${t.cover}" alt="${t.title}" width="36" height="36" loading="eager" decoding="async" />
          </div>
          <div class="pin-tail"></div>
        </div>`,
      });
    }
    return L.divIcon({
      className: "pin-icon",
      iconSize: [44, 44],
      iconAnchor: [22, 44],
      popupAnchor: [0, -46],
      html: `<div class="pin-simple"><span>${num}</span></div>`,
    });
  }

  // ── Popup HTML ────────────────────────────────────────────
  function buildPopup(t: TravelData): string {
    const location = t.country
      ? `${t.locationName} · ${t.country}`
      : t.locationName;
    return `
      <div>
        ${
          t.popupCover
            ? `<div class="pop-cover"><img src="${t.popupCover}" alt="${t.title}" width="280" height="140" loading="lazy" decoding="async" style="width:100%;height:140px;object-fit:cover;display:block;border-top-left-radius:11px;border-top-right-radius:11px;" /></div>`
            : `<div class="pop-cover pop-cover-empty">
               <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(243,238,226,0.2)" stroke-width="1.5" aria-hidden="true">
                 <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                 <circle cx="12" cy="10" r="3"/>
               </svg>
             </div>`
        }
        <div class="pop-body">
          <div class="pop-meta">${location}</div>
          <h3 class="pop-title">${t.title}</h3>
          <p class="pop-excerpt">${t.excerpt}</p>
          <a class="pop-cta" href="${t.url}" aria-label="Ler mais sobre ${t.title}">
            leia mais
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
              <path d="M0 5h12M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.5"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>`;
  }

  const markers: Record<string, L.Marker> = {};

  // ── Popup mobile (elemento próprio, fora da árvore do Leaflet) ──
  // No mobile o popup nativo do Leaflet fica difícil de centralizar de
  // forma confiável (é filho de panes que se movem/transformam junto
  // com o pan do mapa) — em vez disso usamos um card fixo próprio,
  // criado direto no <body>, reaproveitando o mesmo HTML de buildPopup.
  const isMobile = () => window.matchMedia("(max-width: 880px)").matches;

  const mobilePopupEl = document.createElement("div");
  mobilePopupEl.id = "map-mobile-popup";
  document.body.appendChild(mobilePopupEl);

  function closeMobilePopup() {
    mobilePopupEl.classList.remove("is-open");
  }

  function openMobilePopup(t: TravelData) {
    mobilePopupEl.innerHTML = "";
    const closeBtn = document.createElement("button");
    closeBtn.type = "button";
    closeBtn.className = "map-mobile-popup-close";
    closeBtn.setAttribute("aria-label", "Fechar");
    closeBtn.textContent = "×";
    closeBtn.addEventListener("click", closeMobilePopup);
    mobilePopupEl.appendChild(closeBtn);
    mobilePopupEl.insertAdjacentHTML("beforeend", buildPopup(t));
    mobilePopupEl.classList.add("is-open");
  }

  function openDesktopPopup(t: TravelData, marker: L.Marker) {
    L.popup({ maxWidth: 300, closeButton: true, autoPanPadding: [16, 16] })
      .setLatLng(marker.getLatLng())
      .setContent(buildPopup(t))
      .openOn(map);
  }

  function openPopupFor(t: TravelData, marker: L.Marker) {
    if (isMobile()) {
      openMobilePopup(t);
    } else {
      openDesktopPopup(t, marker);
    }
  }

  function setActive(id: string) {
    document.querySelectorAll<HTMLElement>(".card").forEach((c) => {
      c.classList.toggle("active", c.dataset.id === id);
    });
    Object.entries(markers).forEach(([k, m]) => {
      m.getElement()?.classList.toggle("is-active", k === id);
    });
  }

  function focusTravel(id: string, open = true) {
    const t = travels.find((x) => x.id === id);
    if (!t) return;
    setActive(id);
    const m = markers[id];
    if (!m) return;
    map.flyTo([t.lat, t.lng], 8, { duration: 1.1 });
    if (open) setTimeout(() => openPopupFor(t, m), 750);
    document
      .querySelector<HTMLElement>(`.card[data-id="${id}"]`)
      ?.scrollIntoView({ block: "nearest", behavior: "smooth" });
  }

  // ── Add markers ────────────────────────────────────────────
  travels.forEach((t, i) => {
    const marker = L.marker([t.lat, t.lng], { icon: buildPin(t, i) });
    marker.on("click", () => {
      setActive(t.id);
      openPopupFor(t, marker);
    });
    marker.addTo(map);
    markers[t.id] = marker;

    // Adiciona aria-label ao elemento gerado pelo Leaflet para acessibilidade
    const el = marker.getElement();
    if (el) {
      el.setAttribute("aria-label", `${t.title} — ${t.locationName}`);
      el.setAttribute("title", `${t.title} — ${t.locationName}`);
    }
  });

  if (travels.length > 0) {
    const group = L.featureGroup(travels.map((t) => L.marker([t.lat, t.lng])));
    map.fitBounds(group.getBounds().pad(0.4));
    if (travels.length === 1) map.setZoom(10);
  }

  // ── Sidebar card click ────────────────────────────────────────
  document.querySelectorAll<HTMLAnchorElement>(".card").forEach((card) => {
    card.addEventListener("click", (e) => {
      e.preventDefault();
      const id = card.dataset.id;
      if (id) focusTravel(id, true);
    });
  });

  // Fecha o popup mobile ao tocar/clicar no mapa fora de um pino
  map.on("click", closeMobilePopup);

  // ── Hint ────────────────────────────────────────────────────
  const hint = document.getElementById("map-hint");
  if (hint) {
    hint.classList.add("visible");
    setTimeout(() => hint.classList.remove("visible"), 4000);
  }
</script>

<style>
  .map-wrap {
    position: relative;
    z-index: 3;
    background: #2a2622;
    height: 100%;
  }
  #travel-map {
    position: absolute;
    inset: 0;
    background: #2a2622;
  }
  .map-hint {
    position: absolute;
    bottom: 48px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--ui);
    font-size: 12px;
    color: var(--ink-3);
    background: rgba(22, 21, 19, 0.75);
    padding: 6px 14px;
    border-radius: 999px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
    z-index: 500;
    white-space: nowrap;
  }
  .map-hint.visible {
    opacity: 1;
  }
</style>
