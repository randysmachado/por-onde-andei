---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const allLocais = await getCollection("local");
const locais = allLocais
  .filter((t) => !t.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const total = locais.length;

// const firstYear = locais.length
//   ? Math.min(...locais.map((t) => t.data.date.getFullYear())).toString()
//   : new Date().getFullYear().toString();
// const lastYear = new Date().getFullYear().toString();
// const yearRange = firstYear === lastYear ? firstYear : `${firstYear}–${lastYear}`;
---

<aside class="side">
  <!-- ── Brand ── -->
  <header class="side-head">
    <div class="flex gap-3">
      <div class="w-10 h-10 rounded-lg grid place-items-center shrink-0">
        <Image src={logo} alt="Logomarca Por Onde Andei" class="" />
      </div>
      <div>
        <h1
          class="font-display text-[28px] leading-none tracking-[0.02em] text-ink"
        >
          Por Onde Andei
        </h1>
        <h2
          class="font-ui text-[11px] text-ink-3 uppercase tracking-[0.16em] font-bold mt-1"
        >
          de Randys Machado
        </h2>
      </div>
    </div>
  </header>

  <!-- ── List header ── -->
  <div class="list-head">
    <span>Locais visitados</span>
    <span>{total} {total === 1 ? "local" : "locais"}</span>
  </div>

  <!-- ── Card list ── -->
  <div class="list" id="travel-list">
    {
      locais.map((t, i) => {
        const slug = t.id.replace("/index", "");
        const url = `/local/${slug}`;
        const date = t.data.date.toLocaleDateString("pt-BR", {
          month: "short",
          year: "numeric",
        });
        const num = String(i + 1).padStart(2, "0");
        return (
          <a class="card" href={url} data-id={slug}>
            <div
              class={`card-thumb${t.data.cover ? " has-img" : ""}`}
              data-num={num}
            >
              {t.data.cover && (
                <Image
                  src={t.data.cover}
                  alt={t.data.title}
                  width={120}
                  height={120}
                  class="card-thumb-img"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <div class="card-body">
              <div class="card-meta">{date}</div>
              <div class="card-title">{t.data.title}</div>
              <div class="card-loc">{t.data.location.name}</div>
            </div>
          </a>
        );
      })
    }
  </div>

  <!-- ── Footer ── -->
  <div class="side-footer">
    <a href="/locais">Ver todos</a>
    <a href="/sobre">Sobre</a>
  </div>
</aside>

<style>
  .side {
    background: var(--panel);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    min-width: 0;
    position: relative;
    z-index: 2;
    overflow: hidden;
  }
  .side-head {
    padding: 24px 24px 16px;
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }
  .list-head {
    flex-shrink: 0;
    padding: 14px 24px 8px;
    font-family: var(--ui);
    font-size: 10.5px;
    color: var(--ink-3);
    text-transform: var(--eyebrow-tt);
    letter-spacing: var(--eyebrow-ls);
    font-weight: var(--eyebrow-fw);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 10px 16px;
    scrollbar-width: thin;
    scrollbar-color: var(--line-2) transparent;
    display: flex;
    flex-direction: column;
  }
  .list::-webkit-scrollbar {
    width: 6px;
  }
  .list::-webkit-scrollbar-thumb {
    background: var(--line-2);
    border-radius: 3px;
  }

  .card {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.15s ease;
    position: relative;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }
  .card:hover {
    background: var(--panel-2);
  }
  .card.active {
    background: var(--accent-soft);
  }
  .card.active::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 16px;
    bottom: 16px;
    width: 2px;
    background: var(--accent);
    border-radius: 2px;
  }
  .card-thumb {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    background: var(--panel-2);
    border: 1px solid var(--line);
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }
  .card-thumb::after {
    content: attr(data-num);
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-size: 20px;
    color: var(--ink-3);
    background: var(--panel-2);
  }
  .card-thumb.has-img::after {
    display: none;
  }
  .card-thumb-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }

  .card-body {
    min-width: 0;
    padding-top: 1px;
  }
  .card-meta {
    font-family: var(--ui);
    font-size: 10px;
    color: var(--ink-3);
    text-transform: var(--eyebrow-tt);
    letter-spacing: var(--eyebrow-ls);
    font-weight: var(--eyebrow-fw);
    margin-bottom: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-title {
    font-family: var(--display);
    font-size: 20px;
    line-height: 1.05;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin-bottom: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-loc {
    font-family: var(--ui);
    font-size: 11px;
    color: var(--ink-2);
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .card-loc::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
    flex-shrink: 0;
  }
  .side-footer {
    flex-shrink: 0;
    padding: 12px 24px;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 16px;
  }
  .side-footer a {
    font-family: var(--ui);
    font-size: 11px;
    color: var(--ink-3);
    text-transform: var(--eyebrow-tt);
    letter-spacing: var(--eyebrow-ls);
    font-weight: var(--eyebrow-fw);
    text-decoration: none;
    transition: color 0.15s;
  }
  .side-footer a:hover {
    color: var(--accent);
  }

  /* ── Mobile: horizontal scroll ── */
  @media (max-width: 880px) {
    .side {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
    .side-head {
      padding: 12px 16px 10px;
    }
    .list-head {
      display: none;
    }
    .side-footer {
      display: none;
    }
    .list {
      flex-direction: row;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 6px 12px 10px;
      gap: 4px;
      flex: none;
      height: auto;
    }
    .list::-webkit-scrollbar {
      height: 3px;
      width: auto;
    }
    .card {
      min-width: 190px;
      max-width: 190px;
      padding: 8px 10px;
      border-radius: 8px;
    }
    .card-thumb {
      width: 48px;
      height: 48px;
    }
    .card-thumb::after {
      font-size: 17px;
    }
    .card-title {
      font-size: 16px;
    }
    .card-loc {
      font-size: 10px;
    }
  }
</style>
