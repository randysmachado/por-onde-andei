---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  images: ImageMetadata[];
  title?: string;
}

const { images, title = 'Galeria' } = Astro.props;
---

{images.length > 0 && (
  <section class="pt-12 pb-4">
    <header class="flex items-center gap-2.5 mb-5">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
           class="text-ink-3"
           stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
        <circle cx="12" cy="13" r="3"/>
      </svg>
      <span class="font-display text-[32px] leading-none tracking-[0.01em] text-ink">{title}</span>
      <span class="ml-auto font-ui text-[11px] uppercase tracking-[0.16em] font-bold text-ink-3">
        {images.length} foto{images.length !== 1 ? 's' : ''}
      </span>
    </header>

    <div class="grid grid-cols-2 gap-1.5 sm:grid-cols-3">
      {images.map((img, index) => (
        <button
          class="group relative aspect-square overflow-hidden rounded-[6px] cursor-pointer border-0 p-0 bg-panel-2"
          data-index={index}
          aria-label={`Ver foto ${index + 1}`}
        >
          <Image
            src={img}
            alt={`Foto ${index + 1}`}
            class="w-full h-full object-cover block transition-[transform,filter] duration-500 ease-out group-hover:scale-[1.06] group-hover:brightness-75"
            widths={[400, 800]}
            sizes="(max-width: 640px) 50vw, 33vw"
          />
          <div class="absolute inset-0 flex items-center justify-center text-white opacity-0 transition-opacity duration-[250ms] group-hover:opacity-100">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35M11 8v6M8 11h6"/>
            </svg>
          </div>
        </button>
      ))}
    </div>

    <!-- Lightbox (styles in global.css) -->
    <dialog id="lightbox" class="gallery-lightbox">
      <div class="gallery-lightbox-inner">
        <button id="lightbox-close" class="lb-btn lb-close" aria-label="Fechar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.5"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
        <button id="lightbox-prev" class="lb-btn lb-arrow lb-arrow-prev" aria-label="Anterior">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.5"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </button>
        <div class="lb-img-wrap">
          <img id="lightbox-img" src="" alt="" class="lb-img" />
        </div>
        <button id="lightbox-next" class="lb-btn lb-arrow lb-arrow-next" aria-label="Próxima">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.5"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </button>
        <div id="lightbox-counter" class="lb-counter"></div>
      </div>
    </dialog>
  </section>
)}

{images.length === 0 && (
  <section class="mt-8 p-10 text-center border border-dashed border-line-2 rounded-[10px]">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
         class="mx-auto mb-3 text-ink-3"
         stroke="currentColor" stroke-width="1.2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
      <circle cx="9" cy="9" r="2"/>
      <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
    </svg>
    <p class="font-ui text-[13px] text-ink-3 m-0">
      Adicione fotos na pasta <code class="font-mono text-[0.9em] text-accent bg-panel-2 px-1.5 py-0.5 rounded">imagens/</code> deste local
    </p>
  </section>
)}

<script>
  const items = document.querySelectorAll<HTMLButtonElement>('[data-index]');
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxCounter = document.getElementById('lightbox-counter');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement | null;

  if (lightbox && lightboxImg) {
    let currentIndex = 0;
    const srcs = Array.from(items).map((item) => item.querySelector('img')?.src ?? '');

    function open(index: number) {
      currentIndex = index;
      if (lightboxImg) lightboxImg.src = srcs[index] ?? '';
      if (lightboxCounter) lightboxCounter.textContent = `${index + 1} / ${srcs.length}`;
      lightbox?.showModal();
    }
    function navigate(dir: 1 | -1) {
      currentIndex = (currentIndex + dir + srcs.length) % srcs.length;
      open(currentIndex);
    }

    items.forEach((item) => {
      item.addEventListener('click', () => open(Number(item.dataset.index)));
    });
    closeBtn?.addEventListener('click', () => lightbox?.close());
    prevBtn?.addEventListener('click', () => navigate(-1));
    nextBtn?.addEventListener('click', () => navigate(1));
    lightbox.addEventListener('click', (e) => { if (e.target === lightbox) lightbox.close(); });
    document.addEventListener('keydown', (e) => {
      if (!lightbox?.open) return;
      if (e.key === 'Escape') lightbox.close();
      if (e.key === 'ArrowLeft') navigate(-1);
      if (e.key === 'ArrowRight') navigate(1);
    });
  }
</script>
