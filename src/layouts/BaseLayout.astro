---
import "../styles/global.css";
import { SEO } from "astro-seo";
import logo from "../assets/logo.png";
import SchemaOrg from "../components/SchemaOrg.astro";
import type { SchemaType } from "../components/SchemaOrg.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  publishDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  canonicalURL?: string;
  bodyClass?: string;
  // JSON-LD
  schemaType?: SchemaType;
  locationName?: string;
  lat?: number;
  lng?: number;
  country?: string;
  category?: string;
}

const {
  title,
  description = "Por Onde Andei | De Randys Machado.",
  ogImage = "/og-image.png",
  ogType = "website",
  publishDate,
  tags = [],
  canonicalURL = Astro.url.href,
  bodyClass = "",
  schemaType = "website",
  locationName,
  lat,
  lng,
  country,
  category,
  updatedDate,
} = Astro.props;

const siteName = "Por Onde Andei | De Randys Machado.";
const fullTitle = title === siteName ? title : `${title} · Por Onde Andei`;
const ogImageURL = new URL(ogImage, Astro.site).toString();
const logoURL = new URL(logo.src, Astro.site).toString();

---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SEO
      title={fullTitle}
      description={description}
      canonical={canonicalURL}
      noindex={false}
      nofollow={false}
      openGraph={{
        basic: {
          title: fullTitle,
          type: ogType,
          image: ogImageURL,
          url: canonicalURL,
        },
        optional: {
          siteName,
          locale: "pt_BR",
          description,
        },
        image: {
          alt: fullTitle,
          width: 1200,
          height: 630,
          type: "image/webp",
        },
        ...(ogType === "article"
          ? {
              article: {
                publishedTime: publishDate?.toISOString(),
                tags,
              },
            }
          : {}),
      }}
      twitter={{
        card: "summary_large_image",
        site: "@randysmachado",
        creator: "@randysmachado",
        title: fullTitle,
        description,
        image: ogImageURL,
        imageAlt: fullTitle,
      }}
      extend={{
        link: [
          { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
          { rel: "sitemap", href: "/sitemap-index.xml" },
        ],
        meta: [
          { name: "generator", content: Astro.generator },
          { property: "og:logo", content: logoURL },
        ],
      }}
    />

    <!-- Fonts: Bebas Neue + Manrope (assíncronas, não bloqueiam render) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- JSON-LD Structured Data -->
    <SchemaOrg
      type={schemaType}
      title={fullTitle}
      description={description}
      url={canonicalURL}
      image={ogImageURL}
      publishDate={publishDate}
      updatedDate={updatedDate}
      tags={tags}
      locationName={locationName}
      lat={lat}
      lng={lng}
      country={country}
      category={category}
    />

    <!-- Google Analytics (via Partytown — roda em web worker) -->
    <script
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-X769TXPR5R"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-X769TXPR5R");
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
